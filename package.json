{
	"name": "@gottheflag/dust",
	"version": "0.1.0-beta.1",
	"type": "module",
	"description": "Lightweight particle effects engine.",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./effects": {
			"types": "./dist/effects.d.ts",
			"import": "./dist/effects.js",
			"require": "./dist/effects.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"playground": "vite --config ./playground/vite.config.ts"
	},
	"keywords": [
		"dust",
		"particle",
		"confetti",
		"canvas",
		"animation"
	],
	"author": {
		"name": "GTF",
		"url": "https://gottheflag.sa",
		"email": "dev@gottheflag.sa"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gottheflag/dust.git"
	},
	"bugs": {
		"url": "https://github.com/gottheflag/dust/issues"
	},
	"homepage": "https://gottheflag.github.io/dust",
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@gottheflag/ui": "link:..\\ui",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^3.0.0",
		"jsdom": "^26.0.0"
	},
	"dependencies": {
		"@gottheflag/lifecycle": "0.1.0-alpha.2"
	}
}